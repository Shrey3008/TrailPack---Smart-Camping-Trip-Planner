# TrailPack backend — environment variables (post-AWS stack)
# Copy to .env for local development. On Render, set these in the dashboard.

# --- Required ---
# MongoDB Atlas connection string. Get it from Atlas → Connect → Drivers.
# Database name is set via MONGODB_DB.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=trailpack

# Secret used to sign JWTs. Generate one: openssl rand -hex 32
JWT_SECRET=

# --- Server ---
# Render sets PORT automatically; only needed locally.
PORT=3000
NODE_ENV=development

# --- CORS / links ---
# Your Netlify site URL, e.g. https://trailpack.netlify.app
# Used for invite-accept links and email CTAs.
FRONTEND_URL=http://localhost:5500
# Extra allowed origins (comma-separated, "*." wildcard supported).
# *.netlify.app is already allowed by default in server.js.
CORS_ALLOWED_ORIGINS=

# --- Email (Gmail SMTP via nodemailer — sole transport) ---
# EMAIL_PASS must be a Google App Password (Google Account → Security →
# 2-Step Verification → App passwords), NOT your normal Gmail password.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@trailpack.app
# Set to 'true' to disable all outbound email.
DISABLE_EMAIL=false
# Opt-in for the in-process email reminder cron in emailService.
ENABLE_EMAIL_SCHEDULER=false

# --- Weather (OpenWeatherMap) ---
WEATHER_API_KEY=

# --- AI checklist generation ---
# Groq (used by aiService for POST /trips and /trips/:id/ai-items).
# Without this key the rule-based fallback generator is used.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI (optional — retained for legacy aiService methods that
# aren't wired into any active route today).
OPENAI_API_KEY=
